    "typecheck": "wrangler types --check && tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
    "@zuri/shared": "*",
    "agents": "0.30.1",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "wrangler": "4.153.0"
  }
}
