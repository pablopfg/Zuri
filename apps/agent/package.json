{
  "name": "@zuri/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var PUBLIC_URL:http://localhost:8787",
    "build": "wrangler deploy --dry-run --outdir dist",
