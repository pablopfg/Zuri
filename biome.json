{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.wrangler",
      "!test-results",
      "!playwright-report",
      "!coverage",
      "!**/worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["apps/agent/src/**", "packages/shared/src/**", "!apps/agent/src/log.ts"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
