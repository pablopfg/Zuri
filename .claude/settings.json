{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test -w *)",
      "Bash(npm run test:*)",
      "Bash(bash scripts/instalar-skills.sh)",
      "Bash(npm audit --audit-level=high)",
      "Bash(git status)",
      "Bash(git status --short)",
      "Bash(git diff)",
      "Bash(git diff --stat)",
      "Bash(git diff origin/develop...HEAD)",
      "Bash(git diff --stat origin/develop...HEAD)",
      "Bash(git log --oneline)",
      "Bash(git log origin/develop --oneline)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch origin develop)"
    ],
    "deny": [
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler secret*)",
      "Bash(npx wrangler secret*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npm publish*)",
      "Bash(*kie.mjs*)",
      "Read(**/scroll-craft/.env)",
      "Bash(git * --upload-pack*)",
      "Bash(git * --receive-pack*)",
      "Bash(git * --output*)",
      "Bash(git * --ext-diff*)",
      "Bash(git -c *)",
      "Bash(*.env*)",
      "Bash(*.dev.vars*)",
      "Bash(npm audit fix*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/instalar-skills.sh",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@zuri-skills-externas": true,
    "mattpocock-skills@zuri-skills-externas": true,
    "nateherk-design@zuri-skills-externas": true,
    "cloudflare-security-audit@zuri-skills-externas": true,
    "humanizer@zuri-skills-externas": true
  },
  "extraKnownMarketplaces": {
    "zuri-skills-externas": {
      "source": {
        "source": "directory",
        "path": "./.claude/skills-externas"
      }
    }
  }
}
